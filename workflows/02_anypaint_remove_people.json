rder":15,"mode":0,"inputs":[],"outputs":[],"properties":{"Node name for S&R":"Note"},"widgets_values":["Krea2 CcC Paint test — remove people / inpaint.\n\n1. Load an image in Source Image + Mask and use ComfyUI's Mask Editor. White mask = regenerate; black = preserve.\n2. Default mask controls are grow +12px, Gaussian sigma 4, direction outside. Set blur amount to 0 for a hard mask.\n3. Do NOT paint the source green. Paint Prepare neutralizes only the generated region for Qwen/reference conditioning while the original known pixels stay in the latent.\n4. For outpaint, increase expand_left/top/right/bottom on Paint Prepare. Inpaint and outpaint can be combined in one run.\n5. Recommended adapter/runtime test: Krea 2 Turbo + krea2_anypaint_rank32.safetensors, 8 steps, CFG 1, Euler, simple.\n6. If you are not on Blackwell, bypass/remove BlackwellAttentionFix if your ComfyUI installation does not provide it."],"title":"How to test"}],"links":[[1,1,0,4,0,"MODEL"],[2,5,0,6,0,"IMAGE"],[3,5,1,6,1,"MASK"],[4,4,0,7,0,"MODEL"],[5,2,0,7,1,"CLIP"],[6,3,0,7,2,"VAE"],[7,6,0,7,3,"KREA2_PAINT_CONTEXT"],[8,7,0,8,0,"MODEL"],[9,8,0,9,0,"MODEL"],[10,7,1,10,1,"CONDITIONING"],[11,7,2,10,2,"CONDITIONING"],[12,7,3,10,3,"LATENT"],[13,10,0,11,0,"LATENT"],[14,9,0,10,0,"MODEL"],[15,6,1,13,0,"IMAGE"],[16,6,2,14,0,"IMAGE"],[17,11,0,12,0,"IMAGE"]],"groups":[{"title":"Load Krea2 + AnyPaint","bounding":[-40,-50,880,470],"color":"#3f789e"},{"title":"Source + Paint Prepare","bounding":[-40,390,990,590],"color":"#3f789e"},{"title":"Krea2 CcC Paint","bounding":[860,-50,720,430],"color":"#3f789e"},{"title":"Sampling + Output","bounding":[1540,-50,1800,360],"color":"#3f789e"},{"title":"Paint Debug","bounding":[960,390,1620,510],"color":"#3f789e"}],"version":0.4}